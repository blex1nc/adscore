{
  "name": "adscore",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @adscore/web dev",
    "build": "pnpm --filter @adscore/web build",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @adscore/db migrate:dev",
    "db:generate": "pnpm --filter @adscore/db generate",
    "db:seed": "pnpm --filter @adscore/db seed",
    "db:studio": "pnpm --filter @adscore/db studio"
  },
  "packageManager": "pnpm@11.21.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
