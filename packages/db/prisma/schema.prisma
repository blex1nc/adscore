// PHASE 1 MINIMUM ŞEMASI — finalize DEĞİL (HANDOFF §16).
// Research/Competitor/Creative/Campaign/Meta modelleri ilgili fazlarda,
// kullanıcı onayıyla eklenecek.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled bağlantı için: migrate/işlem dışı sorgular pooled URL'den,
  // migration'lar direct URL'den gider. Lokalde ikisi aynı değere işaret eder.
  directUrl = env("DIRECT_URL")
}

enum PlatformRole {
  ADMIN // internal admin panel erişimi (biz)
  USER  // müşteri
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  platformRole PlatformRole @default(USER)
  workspace    Workspace?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// MVP: tek kullanıcı = tek workspace (HANDOFF 21.5). Ekip/roller sonraki faz;
// ownerId unique kaldırılarak membership tablosuna geçilecek.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String   @unique
  brands    Brand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id           String   @id @default(cuid())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId  String
  name         String
  website      String?
  description  String?
  // Hedef pazar kullanıcı tarafından seçilir (HANDOFF 21.5) — ISO 3166-1 alpha-2
  targetMarket String?
  // Panel para birimi tercihi (ISO 4217); Meta faturalaması ad account cinsinden kalır
  currency     String?
  // Üretilecek reklam copy dili (BCP 47)
  copyLanguage String?
  researchRuns ResearchRun[]
  competitors  Competitor[]
  patternAnalyses PatternAnalysis[]
  creativeGenerations CreativeGeneration[]
  creatives    Creative[]
  campaignPlans CampaignPlan[]
  learnings    Learning[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
}

enum ResearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// Phase 2 — Research Engine v1. `result` yapısı henüz finalize değil;
// normalize edilmiş fact/pattern tabloları sonraki fazlarda gelecek.
model ResearchRun {
  id           String          @id @default(cuid())
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       ResearchStatus  @default(QUEUED)
  error        String?
  result       Json?
  model        String?
  promptTokens Int?
  outputTokens Int?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  sources      ResearchSource[]

  @@index([brandId, createdAt])
}

// Phase 3 — Competitor Intelligence v1 (pazar-bazlı hibrit, HANDOFF 21.5).
// v1 yolu: manuel girdi + AI analizi. Ad Library API yolu Meta bağlantısıyla (Phase 5+) gelecek.

enum CompetitorType {
  DIRECT
  INDIRECT
  ASPIRATIONAL
  CREATIVE
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Competitor {
  id        String         @id @default(cuid())
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  name      String
  website   String?
  type      CompetitorType
  note      String?
  // "user" (elle eklendi) | "research" (araştırma adayından eklendi)
  addedFrom String         @default("user")
  ads       CompetitorAd[]
  createdAt DateTime       @default(now())

  @@index([brandId])
}

model CompetitorAd {
  id           String         @id @default(cuid())
  competitor   Competitor     @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  competitorId String
  // Kullanıcının yapıştırdığı reklam metni/tarifi (v1 girdisi)
  inputText    String
  // Ad Library veya reklam linki — kaynak referansı olarak saklanır, içerik kopyalanmaz (karar: 2026-08-12)
  inputUrl     String?
  status       AnalysisStatus @default(QUEUED)
  analysis     Json?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([competitorId])
}

// CLAUDE.md §12 — pattern tek reklamdan değil, birden çok analizden çıkar
model PatternAnalysis {
  id           String         @id @default(cuid())
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       AnalysisStatus @default(QUEUED)
  adCount      Int
  result       Json?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([brandId, createdAt])
}

// Phase 4 — Creative Studio v1 (yalnız copy; görsel/video sonraki aşama).
// Onaysız creative hiçbir kampanyada kullanılamaz (CLAUDE.md §16).

enum CreativeApproval {
  PENDING
  APPROVED
  REJECTED
}

model CreativeGeneration {
  id           String         @id @default(cuid())
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       AnalysisStatus @default(QUEUED)
  // Kullanıcı yönlendirmesi (opsiyonel) ve kullanıcının verdiği GERÇEK teklif.
  // Teklif kullanıcıdan gelmediyse üretimde teklif kullanılmaz (uydurma yasak).
  instruction  String?
  offer        String?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  creatives    Creative[]
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([brandId, createdAt])
}

model Creative {
  id           String             @id @default(cuid())
  brand        Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  generation   CreativeGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  generationId String
  approval     CreativeApproval   @default(PENDING)
  strategy     String
  hook         String
  primaryText  String
  headline     String
  description  String?
  cta          String
  targetNote   String?
  why          String
  confidence   String
  editedAt     DateTime?
  images       CreativeImage[]
  campaignPlans CampaignPlan[]    @relation("PlanCreatives")
  createdAt    DateTime           @default(now())

  @@index([brandId, createdAt])
}

// Phase 5' — Manuel Yayın Kiti (Meta bağlantısı ertelendi, kullanıcı kararı 2026-08-12).
// Plan, Ads Manager'da elle kurulum için TÜM ayarları verir; API publish yok.

enum BudgetType {
  DAILY
  LIFETIME
}

model CampaignPlan {
  id           String         @id @default(cuid())
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       AnalysisStatus @default(QUEUED)
  goal         String
  // Bütçe kullanıcıdan gelir (CLAUDE.md §19) — AI bütçe belirlemez
  budgetType   BudgetType
  budgetAmount Decimal        @db.Decimal(12, 2)
  currency     String
  durationDays Int?
  notes        String?
  creatives    Creative[]     @relation("PlanCreatives")
  results      CampaignResult[]
  result       Json?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([brandId, createdAt])
}

// Görsel üretim (Creative Studio uzantısı). Dosyalar lokal .data dizininde;
// production'da S3'e taşınacak (HANDOFF mimari kararı).
model CreativeImage {
  id         String         @id @default(cuid())
  creative   Creative       @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  creativeId String
  status     AnalysisStatus @default(QUEUED)
  prompt     String
  // Görsel baytları DB'de tutulur: Vercel'de kalıcı disk yok; S3'e geçiş
  // production ölçeğinde yapılacak (HANDOFF notu).
  data       Bytes?
  mimeType   String?
  error      String?
  model      String?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?

  @@index([creativeId])
}

// Phase 7' — Manuel sonuç girişi + analiz + öğrenme döngüsü.
// Meta bağlı olmadığından performans verisini KULLANICI girer (CLAUDE.md §24 notu:
// gerçek conversion tracking yoksa bu açıkça belirtilir). Türetilmiş metrikler
// (CTR/CPC/CPM/CPA/ROAS) koddan hesaplanır, AI'a hazır verilir; AI sayı üretmez.

model CampaignResult {
  id             String          @id @default(cuid())
  plan           CampaignPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId         String
  periodStart    DateTime
  periodEnd      DateTime
  spend          Decimal         @db.Decimal(12, 2)
  impressions    Int
  clicks         Int
  reach          Int?
  purchases      Int?
  revenue        Decimal?        @db.Decimal(12, 2)
  notes          String?
  analysisStatus AnalysisStatus?
  analysis       Json?
  analysisError  String?
  model          String?
  promptTokens   Int?
  outputTokens   Int?
  createdAt      DateTime        @default(now())

  @@index([planId, createdAt])
}

// CLAUDE.md §26 — marka bazında öğrenme; sample size notu zorunlu
model Learning {
  id             String   @id @default(cuid())
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String
  text           String
  evidence       String
  confidence     String
  sampleNote     String
  sourceResultId String?
  createdAt      DateTime @default(now())

  @@index([brandId, createdAt])
}

// CLAUDE.md §37 — kaynak takibi: her araştırma verisinin nereden geldiği kayıtlı
model ResearchSource {
  id          String      @id @default(cuid())
  run         ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId       String
  url         String
  type        String
  reliability String
  usedFor     String?
  httpStatus  Int?
  retrievedAt DateTime    @default(now())
}

// Davetli onboarding (HANDOFF 21.5) — davetler internal admin panelden açılır
model Invitation {
  id        String    @id @default(cuid())
  email     String?
  token     String    @unique
  invitedBy String
  usedAt    DateTime?
  usedById  String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// CLAUDE.md §41 — önemli işlemler loglanır
model AuditLog {
  id            String   @id @default(cuid())
  workspaceId   String?
  userId        String?
  action        String
  entity        String?
  entityId      String?
  previousState Json?
  newState      Json?
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
}
