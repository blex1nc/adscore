// PHASE 1 MINIMUM ŞEMASI — finalize DEĞİL (HANDOFF §16).
// Research/Competitor/Creative/Campaign/Meta modelleri ilgili fazlarda,
// kullanıcı onayıyla eklenecek.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Not: directUrl bilinçli olarak YOK. Neon migration'ları için direct URL,
  // scripts/migrate-deploy.mjs tarafından pooled URL'den türetilir
  // (hostname'deki "-pooler" eki kaldırılır). Ekstra env değişkeni gerekmez.
}

enum PlatformRole {
  ADMIN // internal admin panel erişimi (biz)
  USER  // müşteri
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  platformRole PlatformRole @default(USER)
  workspace    Workspace?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// MVP: tek kullanıcı = tek workspace (HANDOFF 21.5). Ekip/roller sonraki faz;
// ownerId unique kaldırılarak membership tablosuna geçilecek.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String   @unique
  brands    Brand[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brand {
  id           String   @id @default(cuid())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId  String
  name         String
  website      String?
  description  String?
  // Hedef pazar kullanıcı tarafından seçilir (HANDOFF 21.5) — ISO 3166-1 alpha-2
  targetMarket String?
  // Panel para birimi tercihi (ISO 4217); Meta faturalaması ad account cinsinden kalır
  currency     String?
  // Üretilecek reklam copy dili (BCP 47)
  copyLanguage String?
  // Sprint 2026-08-23 (Ajan C) — marka zenginleştirme: ton/ses, USP, ürün listesi
  brandVoice   String?
  usp          String?
  // [{ name, price?: string, url?: string, description?: string }]
  products     Json?
  assets       BrandAsset[]
  evolutionRuns EvolutionRun[]
  researchRuns ResearchRun[]
  competitors  Competitor[]
  patternAnalyses PatternAnalysis[]
  creativeGenerations CreativeGeneration[]
  creatives    Creative[]
  campaignPlans CampaignPlan[]
  learnings    Learning[]
  optimizationRuns OptimizationRun[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
}

enum ResearchStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// Phase 2 — Research Engine v1. `result` yapısı henüz finalize değil;
// normalize edilmiş fact/pattern tabloları sonraki fazlarda gelecek.
model ResearchRun {
  id           String          @id @default(cuid())
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       ResearchStatus  @default(QUEUED)
  error        String?
  result       Json?
  model        String?
  promptTokens Int?
  outputTokens Int?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime        @default(now())
  sources      ResearchSource[]

  @@index([brandId, createdAt])
}

// Phase 3 — Competitor Intelligence v1 (pazar-bazlı hibrit, HANDOFF 21.5).
// v1 yolu: manuel girdi + AI analizi. Ad Library API yolu Meta bağlantısıyla (Phase 5+) gelecek.

enum CompetitorType {
  DIRECT
  INDIRECT
  ASPIRATIONAL
  CREATIVE
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model Competitor {
  id        String         @id @default(cuid())
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  name      String
  website   String?
  type      CompetitorType
  note      String?
  // "user" (elle eklendi) | "research" (araştırma adayından eklendi)
  addedFrom String         @default("user")
  ads       CompetitorAd[]
  createdAt DateTime       @default(now())

  @@index([brandId])
}

model CompetitorAd {
  id           String         @id @default(cuid())
  competitor   Competitor     @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  competitorId String
  // Kullanıcının yapıştırdığı reklam metni/tarifi (v1 girdisi)
  inputText    String
  // Ad Library veya reklam linki — kaynak referansı olarak saklanır, içerik kopyalanmaz (karar: 2026-08-12)
  inputUrl     String?
  status       AnalysisStatus @default(QUEUED)
  analysis     Json?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([competitorId])
}

// CLAUDE.md §12 — pattern tek reklamdan değil, birden çok analizden çıkar
model PatternAnalysis {
  id           String         @id @default(cuid())
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       AnalysisStatus @default(QUEUED)
  adCount      Int
  result       Json?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([brandId, createdAt])
}

// Phase 4 — Creative Studio v1 (yalnız copy; görsel/video sonraki aşama).
// Onaysız creative hiçbir kampanyada kullanılamaz (CLAUDE.md §16).

enum CreativeApproval {
  PENDING
  APPROVED
  REJECTED
}

model CreativeGeneration {
  id           String         @id @default(cuid())
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       AnalysisStatus @default(QUEUED)
  // Kullanıcı yönlendirmesi (opsiyonel) ve kullanıcının verdiği GERÇEK teklif.
  // Teklif kullanıcıdan gelmediyse üretimde teklif kullanılmaz (uydurma yasak).
  instruction  String?
  offer        String?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  creatives    Creative[]
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([brandId, createdAt])
}

model Creative {
  id           String             @id @default(cuid())
  brand        Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  generation   CreativeGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  generationId String
  approval     CreativeApproval   @default(PENDING)
  strategy     String
  hook         String
  primaryText  String
  headline     String
  description  String?
  cta          String
  targetNote   String?
  why          String
  confidence   String
  editedAt     DateTime?
  images       CreativeImage[]
  campaignPlans CampaignPlan[]    @relation("PlanCreatives")
  createdAt    DateTime           @default(now())

  @@index([brandId, createdAt])
}

// Phase 5' — Manuel Yayın Kiti (Meta bağlantısı ertelendi, kullanıcı kararı 2026-08-12).
// Plan, Ads Manager'da elle kurulum için TÜM ayarları verir; API publish yok.

enum BudgetType {
  DAILY
  LIFETIME
}

model CampaignPlan {
  id           String         @id @default(cuid())
  brand        Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId      String
  status       AnalysisStatus @default(QUEUED)
  goal         String
  // Bütçe kullanıcıdan gelir (CLAUDE.md §19) — AI bütçe belirlemez
  budgetType   BudgetType
  budgetAmount Decimal        @db.Decimal(12, 2)
  currency     String
  durationDays Int?
  notes        String?
  creatives    Creative[]     @relation("PlanCreatives")
  results      CampaignResult[]
  // Sprint 2026-08-23 (Ajan B) — kullanıcı "Ads Manager'da yayınladım" dedi
  publishedAt  DateTime?
  // ör. Ads Manager kampanya adı/ID (kullanıcı elle girer)
  publishNote  String?
  kits         PublishKit[]
  result       Json?
  error        String?
  model        String?
  promptTokens Int?
  outputTokens Int?
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  @@index([brandId, createdAt])
}

// Görsel üretim (Creative Studio uzantısı). Dosyalar lokal .data dizininde;
// production'da S3'e taşınacak (HANDOFF mimari kararı).
model CreativeImage {
  id         String         @id @default(cuid())
  creative   Creative       @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  creativeId String
  status     AnalysisStatus @default(QUEUED)
  prompt     String
  // Görsel baytları DB'de tutulur: Vercel'de kalıcı disk yok; S3'e geçiş
  // production ölçeğinde yapılacak (HANDOFF notu).
  data       Bytes?
  mimeType   String?
  error      String?
  model      String?
  createdAt  DateTime       @default(now())
  finishedAt DateTime?

  @@index([creativeId])
}

// Phase 7' — Manuel sonuç girişi + analiz + öğrenme döngüsü.
// Meta bağlı olmadığından performans verisini KULLANICI girer (CLAUDE.md §24 notu:
// gerçek conversion tracking yoksa bu açıkça belirtilir). Türetilmiş metrikler
// (CTR/CPC/CPM/CPA/ROAS) koddan hesaplanır, AI'a hazır verilir; AI sayı üretmez.

model CampaignResult {
  id             String          @id @default(cuid())
  plan           CampaignPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId         String
  periodStart    DateTime
  periodEnd      DateTime
  spend          Decimal         @db.Decimal(12, 2)
  impressions    Int
  clicks         Int
  reach          Int?
  purchases      Int?
  revenue        Decimal?        @db.Decimal(12, 2)
  notes          String?
  analysisStatus AnalysisStatus?
  analysis       Json?
  analysisError  String?
  model          String?
  promptTokens   Int?
  outputTokens   Int?
  createdAt      DateTime        @default(now())

  @@index([planId, createdAt])
}

// CLAUDE.md §26 — marka bazında öğrenme; sample size notu zorunlu
model Learning {
  id             String   @id @default(cuid())
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String
  text           String
  evidence       String
  confidence     String
  sampleNote     String
  sourceResultId String?
  createdAt      DateTime @default(now())

  @@index([brandId, createdAt])
}

// Phase 8 — Optimizasyon Motoru (Meta'sız). Skorlar/sinyaller KODDAN hesaplanır
// ve `input` alanında snapshot olarak saklanır; AI yalnız yorum + öneri üretir.
// Öneriler otomatik uygulanmaz (CLAUDE.md §30) — kullanıcı kabul/reddet eder.

enum RecommendationStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

model OptimizationRun {
  id              String           @id @default(cuid())
  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId         String
  status          AnalysisStatus   @default(QUEUED)
  // Analize giren yeterli-veri sonuç sayısı (CLAUDE.md §28 — sample size kaydı)
  resultCount     Int
  // Kod hesabı snapshot: AdScore'lar + sinyaller + metrikler (AI'a verilen veri)
  input           Json?
  result          Json?
  error           String?
  model           String?
  promptTokens    Int?
  outputTokens    Int?
  recommendations Recommendation[]
  createdAt       DateTime         @default(now())
  finishedAt      DateTime?

  @@index([brandId, createdAt])
}

model Recommendation {
  id          String               @id @default(cuid())
  run         OptimizationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId       String
  // Listeleme için denormalize; tenant kontrolü run.brand üzerinden yapılır
  brandId     String
  // "optimization" | "test" (test = tek değişkenli sonraki deney önerisi, §27)
  kind        String
  observation String
  causes      String?
  evidence    String
  action      String
  confidence  String
  status      RecommendationStatus @default(PROPOSED)
  decidedAt   DateTime?
  createdAt   DateTime             @default(now())

  @@index([brandId, createdAt])
}

// CLAUDE.md §37 — kaynak takibi: her araştırma verisinin nereden geldiği kayıtlı
model ResearchSource {
  id          String      @id @default(cuid())
  run         ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId       String
  url         String
  type        String
  reliability String
  usedFor     String?
  httpStatus  Int?
  retrievedAt DateTime    @default(now())
}

// Davetli onboarding (HANDOFF 21.5) — davetler internal admin panelden açılır
model Invitation {
  id        String    @id @default(cuid())
  email     String?
  token     String    @unique
  invitedBy String
  usedAt    DateTime?
  usedById  String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// CLAUDE.md §41 — önemli işlemler loglanır
model AuditLog {
  id            String   @id @default(cuid())
  workspaceId   String?
  userId        String?
  action        String
  entity        String?
  entityId      String?
  previousState Json?
  newState      Json?
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
}

// ===================================================================
// SPRINT 2026-08-23 — ortak migration (docs/CONTRACTS.md §3). Şema sahibi: Ajan A.
// ===================================================================

// ---------- ARENA: Creative Evolution Engine (Ajan A) ----------
// Arena skoru adaylar arası GÖRELİ sıralamadır; performans tahmini değildir
// (CLAUDE.md §6/§31). Tahmini CTR/CPC/ROAS/erişim hiçbir yerde üretilmez.

enum EvolutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EvolutionStage {
  GENERATE // adaylar üretiliyor (tohum veya mutasyon)
  LINT     // deterministik kural kontrolü
  JUDGE    // AI jüri paneli
  SELECT   // skor birleştirme + seçilim
  DONE
}

enum CandidateOrigin {
  SEED
  MUTATION
  CROSSOVER
  ELITE
}

model EvolutionRun {
  id               String               @id @default(cuid())
  brand            Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId          String
  status           EvolutionStatus      @default(QUEUED)
  // Kullanıcı girdileri
  goal             String // "sales" | "traffic" | "leads" | "awareness" (lib/options.ts CAMPAIGN_GOALS)
  offer            String? // kullanıcının GERÇEK teklifi; yoksa hiçbir adayda teklif yok
  instruction      String?
  // Döngü ayarları — kullanıcı seçer, sınırlar kodda (EVOLUTION_LIMITS)
  config           Json // { rounds, population, survivors, judges }
  currentRound     Int                  @default(0)
  maxRounds        Int
  // Sonuç
  winnerCreativeId String? // kazanan, Creative tablosuna yazılır (onay akışına girer)
  summary          Json? // { convergence, winnerRationale, confidence, dataBasis, disclaimer }
  error            String?
  model            String?
  promptTokens     Int?
  outputTokens     Int?
  rounds           EvolutionRound[]
  candidates       EvolutionCandidate[]
  createdAt        DateTime             @default(now())
  finishedAt       DateTime?

  @@index([brandId, createdAt])
}

model EvolutionRound {
  id               String               @id @default(cuid())
  run              EvolutionRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId            String
  index            Int // 0-tabanlı
  stage            EvolutionStage       @default(GENERATE)
  // Açıklanabilirlik: jüriye ne verildi, ne döndü (snapshot)
  judgeInput       Json?
  judgeOutput      Json?
  // Yarış koruması (AGENT-A §3): aşamaya başlamadan koşullu yazımla claim alınır;
  // 90 sn'den eski claim çökmüş sayılır ve devralınır.
  claimedAt        DateTime?
  // Sözleşme dışı tek ek (Ajan A modeli): tüm adaylar lint'te elendiğinde GENERATE
  // bir kez tekrarlanır; ikinci boş denemede koşu FAILED olur. Sayaç burada tutulur.
  generateAttempts Int                  @default(0)
  promptTokens     Int?
  outputTokens     Int?
  startedAt        DateTime             @default(now())
  finishedAt       DateTime?
  candidates       EvolutionCandidate[]

  @@unique([runId, index])
}

model EvolutionCandidate {
  id               String          @id @default(cuid())
  run              EvolutionRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId            String
  round            EvolutionRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId          String
  parentId         String? // mutasyon/crossover/elit kaynağı (EvolutionCandidate.id)
  origin           CandidateOrigin
  // Creative ile aynı alan seti (kazanan birebir Creative'e kopyalanır)
  strategy         String
  hook             String
  primaryText      String
  headline         String
  description      String?
  cta              String
  targetNote       String?
  why              String
  // Skorlar
  lintScore        Int // 0-100, deterministik
  lintIssues       Json // [{ rule, severity: "hard"|"soft", message }]
  judgeScore       Decimal?        @db.Decimal(5, 2) // 0-100, jüri ortalaması (lint'ten geçenler için)
  judgeBreakdown   Json? // { judges: { [judgeKey]: { scores, critique, suggestedMutation } }, borda }
  totalScore       Decimal?        @db.Decimal(5, 2) // AGENT-A §5 formülü
  rank             Int?
  survived         Boolean         @default(false)
  eliminatedReason String?
  createdAt        DateTime        @default(now())

  @@index([runId, roundId])
}

// ---------- KİT: Ads Manager Kurulum Kiti v2 (Ajan B) ----------
model PublishKit {
  id        String       @id @default(cuid())
  plan      CampaignPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId    String
  version   Int          @default(1)
  // AGENT-B §4 şeması — deterministik olarak plan + onaylı creative'lerden üretilir
  kit       Json
  // Kullanıcının Ads Manager'da işaretlediği adımlar: { [stepId]: true }
  checklist Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([planId])
}

// ---------- MARKA ZENGİNLEŞTİRME: marka asset'leri (Ajan C) ----------
enum BrandAssetKind {
  LOGO
  PRODUCT_IMAGE
  OTHER
}

model BrandAsset {
  id        String         @id @default(cuid())
  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId   String
  kind      BrandAssetKind
  name      String
  // CreativeImage ile aynı karar: DB'de bytea (Vercel'de disk yok)
  data      Bytes
  mimeType  String
  createdAt DateTime       @default(now())

  @@index([brandId])
}
